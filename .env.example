# Postgres connection string (Neon → Connection details)
DATABASE_URL=

# Better Auth: generate with `openssl rand -base64 32`; the URL is where the app runs
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob store with public access (Vercel → Storage → Blob → .env.local tab)
BLOB_READ_WRITE_TOKEN=
